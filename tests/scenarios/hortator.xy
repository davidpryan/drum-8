# bdtrx (Hortator's BDTRX, dsp/hort.c; Hortator's models follow the kit's own 30): put on a key it comes with Hortator's defaults
# (TUNE -4: 60) on both pages of knobs, and plays
wait 300
listen
expect trk 1
tap EDIT
expect page Engine
tapkey b1
knob 1 d1.model 52
wait 60
expect par1.d1.model 52
expect par1.d1.k1 60
expect par1.d1.k2 68
expect par1.d1.k5 14
expect par1.d1.k8 24
shot trxkick.png
tapkey b1
wait 500
expect peak_db_max 0
shot trxkick2.png
# DRUM SOUND (the key's list): Hortator's factory presets, the model and its eight knobs onto the key shown (b1: key 2)
tap SEL
row DRUM SOUND
turn ALGO 1
tap SEL
wait 40
said DRUM SOUND
expect par1.d2.model 53
expect par1.d2.k1 64
expect par1.d2.k2 7
expect par1.d2.k3 127
expect par1.d2.k7 92
# the factory kits of Hortator's presets, after LOOM-8's ten: TRX (Loom, ten, then it)
tap SEL
row KIT
turn ALGO 11
tap SEL
wait 40
said KIT
expect par1.d1.model 52
expect par1.d2.model 53
expect par1.d3.mode 3
expect par1.d11.model 58
shot hortkit.png
tapkey b1
wait 500
expect peak_db_max 0
